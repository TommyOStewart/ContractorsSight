{
  "name": "contractorsight",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "export:tool-schemas": "pnpm --filter @contractorsight/shared export:json-schema",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/db/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.119.0"
  }
}
