{
  "name": "@contractorsight/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "vitest run test/unit",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "vitest run test/integration",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "eval:aggregate": "tsx evals/aggregate.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@contractorsight/shared": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "hono": "^4.13.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
