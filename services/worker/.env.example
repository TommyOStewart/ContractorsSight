# Copy to .env and fill in. Never commit .env.

# Postgres connection string. Supabase dashboard -> Connect -> "Transaction pooler" (port 6543),
# with your database password filled in.
# Local stack: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Same project URL and publishable key as apps/mobile/.env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

PORT=8787

# OpenRouter key for the planner eval (pnpm --filter @contractorsight/worker eval). Set a credit limit on it.
OPENROUTER_API_KEY=

# Planner model (OpenRouter ID) and settings for captures.
PLANNER_MODEL=openai/gpt-6.1-sol
PLANNER_EFFORT=medium
TIMEZONE=America/Chicago

# Speech-to-text model (OpenRouter ID) for voice notes.
TRANSCRIBE_MODEL=openai/gpt-transcribe

# Vision model (OpenRouter ID) that reads photos of notes and receipts.
READ_IMAGE_MODEL=google/gemini-3.8-flash
