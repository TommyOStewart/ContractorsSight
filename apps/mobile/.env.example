# Copy to .env. Values come from the Supabase dashboard (Project Settings -> API keys),
# or from `npx supabase status` for the local stack.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Worker on your PC, reachable from the phone over Wi-Fi (use the PC's LAN IP, not localhost).
EXPO_PUBLIC_WORKER_URL=http://192.168.x.x:8787
